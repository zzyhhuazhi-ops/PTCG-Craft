      "cardId": "me5-5_en_011",
      "component": "ability",
      "name": "Fiery Flapping",
      "textEn": "Once during your turn, if you have Articuno and Zapdos in play, you may use this Ability. Attach a Basic <sprite name=\"fire\" tint=1> Energy card from your hand to this Pokémon.",
      "textZh": "如果自己场上有「急冻鸟」「闪电鸟」的话，则在自己的回合可以使用1次。选择自己手牌中的1张「基本<sprite name=\"fire\" tint=1>能量」，附着于这只宝可梦身上。",
      "mapping": {
        "rules": [
          "ability-two-named-partners-hand-energy"
        ],
        "fields": {
          "abilityKind": "ACTIVATED_ONCE_PER_TURN"
        },
        "program": [
          {
            "type": "conditional",
            "conditions": [
              {
                "type": "POKEMON_COUNT",
                "target": "SELF",
                "pokemon_names": "Articuno",
                "value": 1
              },
              {
                "type": "POKEMON_COUNT",
                "target": "SELF",
                "pokemon_names": "Zapdos",
                "value": 1
              }
            ],
            "effects": [
              {
                "type": "attach_energy",
                "source": "HAND",
                "target": "SELF",
                "target_scope": "OWN_FIELD",
                "amount": 1,
                "minimum": 1,
                "basic_energy_only": true,
                "energy_type": "FIRE"
              }
            ]
          }
        ],
        "triggers": [],
        "opcode": null
      }
